{
  "name": "monk-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Monk Harness: an agent harness distribution built on the DeepSeek Harness plugin framework, defaulting to the Monk fused-model API",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "node --test 'packages/*/tests/*.spec.ts'",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
